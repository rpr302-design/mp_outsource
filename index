    <style>
        :root {
            --bg-main: #0c1017;
            --bg-card: #161c26;
            --bg-card-hover: #1e2634;
            --gold-primary: #f59e0b;
            --gold-light: #fbbf24;
            --gold-gradient: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
            --yellow-accent: #facc15;
            --text-main: #ffffff;
            --text-sub: #94a3b8;
            --text-dark: #0f172a;
            --border-color: rgba(245, 158, 11, 0.25);
            --card-border: rgba(255, 255, 255, 0.08);
            --shadow-gold: 0 4px 20px -2px rgba(245, 158, 11, 0.25);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            font-family: 'Yantramanav', 'Plus Jakarta Sans', sans-serif;
            background-color: var(--bg-main);
            color: var(--text-main);
            padding-bottom: 95px;
            line-height: 1.6;
            overflow-x: hidden;
        }

        /* --- Top Alert Bar --- */
        .top-alert-bar {
            background: var(--gold-gradient);
            color: #000;
            font-size: 11px;
            font-weight: 800;
            padding: 6px 12px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            letter-spacing: 0.3px;
        }
        .top-alert-bar a {
            color: #000;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }

        /* --- Main Header Section --- */
        .main-header {
            background: linear-gradient(180deg, #161c26 0%, #0c1017 100%);
            padding: 24px 16px 18px;
            text-align: center;
            border-bottom: 1px solid var(--border-color);
            position: relative;
        }
        .logo-wrap {
            position: relative;
            display: inline-block;
            margin-bottom: 12px;
        }
        .logo-img {
            width: 76px;
            height: 76px;
            border-radius: 50%;
            border: 3px solid var(--gold-light);
            background: #fff;
            box-shadow: 0 0 20px rgba(245, 158, 11, 0.35);
            object-fit: cover;
        }
        .samiti-name {
            font-size: 18px;
            font-weight: 900;
            color: #ffffff;
            margin: 0 0 6px;
            line-height: 1.3;
            letter-spacing: 0.2px;
        }
        .samiti-name span {
            color: var(--gold-light);
        }
        .reg-badge {
            font-size: 11px;
            font-weight: 600;
            color: var(--gold-light);
            background: rgba(245, 158, 11, 0.12);
            padding: 4px 14px;
            border-radius: 20px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            border: 1px solid rgba(245, 158, 11, 0.3);
        }

        /* --- Leaders Quick Info --- */
        .leaders-bar {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            padding: 12px 16px;
            background: #111620;
            border-bottom: 1px solid var(--card-border);
        }
        .leader-box {
            background: rgba(255, 255, 255, 0.02);
            padding: 8px 12px;
            border-radius: 10px;
            border-left: 3px solid var(--gold-primary);
            font-size: 11px;
            color: var(--text-sub);
        }
        .leader-box b {
            display: block;
            color: #ffffff;
            font-size: 12px;
            margin-bottom: 2px;
        }
        .leader-box a {
            color: var(--gold-light);
            text-decoration: none;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 4px;
            margin-top: 2px;
        }

        /* --- Slogan Strip (Jan Suraaj Style) --- */
        .slogan-strip {
            text-align: center;
            padding: 14px 16px;
            background: rgba(245, 158, 11, 0.05);
            border-bottom: 1px solid var(--card-border);
        }
        .slogan-strip h2 {
            font-size: 14px;
            font-weight: 800;
            color: var(--gold-light);
            letter-spacing: 0.5px;
            text-transform: uppercase;
        }
        .slogan-strip p {
            font-size: 11px;
            color: var(--text-sub);
            margin-top: 2px;
        }

        /* --- Action Grid --- */
        .action-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            padding: 16px;
        }
        .action-card {
            background: var(--bg-card);
            padding: 16px 12px;
            border-radius: 14px;
            border: 1px solid var(--card-border);
            text-align: center;
            text-decoration: none;
            color: #ffffff;
            cursor: pointer;
            transition: all 0.25s ease;
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }
        .action-card:active {
            transform: scale(0.97);
            background: var(--bg-card-hover);
        }
        .action-card i {
            font-size: 24px;
            color: var(--gold-primary);
            margin-bottom: 8px;
            transition: transform 0.2s;
        }
        .action-card span {
            font-size: 12px;
            font-weight: 700;
            line-height: 1.2;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }

        /* Special Highlighting Primary Button */
        .action-card.btn-hero {
            grid-column: span 2;
            background: var(--gold-gradient);
            color: #000;
            border: none;
            padding: 18px 14px;
            box-shadow: var(--shadow-gold);
        }
        .action-card.btn-hero i {
            color: #000;
            font-size: 26px;
        }
        .action-card.btn-hero span {
            font-size: 14px;
            font-weight: 900;
            letter-spacing: 0.5px;
        }

        /* --- Share Button Strip --- */
        .share-strip {
            padding: 0 16px 16px;
        }
        .btn-share {
            width: 100%;
            padding: 14px;
            background: #22c55e;
            color: #fff;
            border: none;
            border-radius: 12px;
            font-weight: 800;
            font-size: 13px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            box-shadow: 0 4px 12px rgba(34, 197, 94, 0.25);
            transition: 0.2s;
        }
        .btn-share:active {
            transform: scale(0.98);
        }

        /* --- Content Sections --- */
        .content-view {
            display: none;
            padding: 0 16px;
            animation: modernFade 0.35s ease forwards;
        }
        .content-view.active {
            display: block;
        }
        @keyframes modernFade {
            from { opacity: 0; transform: translateY(8px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .info-card {
            background: var(--bg-card);
            border-radius: 16px;
            padding: 18px;
            border: 1px solid var(--card-border);
            margin-bottom: 16px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        }
        .info-card h3 {
            margin: 0 0 14px;
            font-size: 15px;
            color: var(--gold-light);
            border-bottom: 1px solid rgba(245, 158, 11, 0.2);
            padding-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        /* Live Counter Card */
        .stats-hero-card {
            text-align: center;
            background: linear-gradient(180deg, #1e2634 0%, #131923 100%);
            border: 1px solid var(--border-color);
            padding: 24px 16px;
            border-radius: 18px;
            margin-bottom: 16px;
        }
        .stats-hero-card h2 {
            font-size: 40px;
            font-weight: 900;
            color: var(--yellow-accent);
            letter-spacing: -1px;
            margin-bottom: 4px;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
        .stats-hero-card p {
            color: var(--text-sub);
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
        }

        /* List Rows */
        .list-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            font-size: 13px;
        }
        .list-row:last-child { border: none; }
        .list-row span { color: #e2e8f0; font-weight: 500; }
        .list-row b {
            color: var(--gold-light);
            font-size: 12px;
            background: rgba(245, 158, 11, 0.1);
            padding: 2px 8px;
            border-radius: 6px;
        }

        /* Department Grid */
        .dept-grid {
            column-count: 2;
            column-gap: 14px;
            color: #cbd5e1;
            font-size: 12px;
            line-height: 1.9;
        }
        .dept-grid div {
            break-inside: avoid;
            margin-bottom: 4px;
        }

        /* Bottom Fixed Navigation */
        .bottom-nav {
            position: fixed;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 70px;
            background: rgba(15, 23, 42, 0.95);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            display: flex;
            justify-content: space-around;
            align-items: center;
            border-top: 1px solid var(--border-color);
            z-index: 2000;
            padding-bottom: 4px;
        }
        .nav-link {
            text-decoration: none;
            color: var(--text-sub);
            text-align: center;
            font-size: 10px;
            font-weight: 700;
            flex: 1;
            transition: 0.2s;
        }
        .nav-link.active {
            color: var(--gold-light);
        }
        .nav-link i {
            font-size: 20px;
            display: block;
            margin-bottom: 4px;
        }
    </style>
</head>
